# Keep this key on the backend only. Never use a VITE_ prefix for secrets.
SERPAPI_API_KEY=PASTE_YOUR_SERPAPI_KEY_HERE
FRONTEND_ORIGIN=http://localhost:5173
RESTAURANT_DISCOVERY_CACHE_TTL_MINUTES=30
RESTAURANT_DETAILS_CACHE_TTL_MINUTES=15
# Use a long random value in deployed environments.
FOODSCOUT_AUTH_SECRET=replace-with-a-random-secret
# Optional absolute path for the local SQLite account store.
# FOODSCOUT_AUTH_DB=backend/foodscout_auth.sqlite3
# Persistent database. Defaults to the existing SQLite account store.
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/foodscout
# DATABASE_URL=sqlite:///backend/foodscout_auth.sqlite3
